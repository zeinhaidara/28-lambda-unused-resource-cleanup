{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyRecheck",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAddresses",
        "ec2:DescribeImages",
        "ec2:DescribeInstances",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeNetworkInterfaces",
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeTargetGroups",
        "elasticloadbalancing:DescribeTargetHealth"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DeleteApprovedEc2Resources",
      "Effect": "Allow",
      "Action": [
        "ec2:ReleaseAddress",
        "ec2:DeregisterImage",
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:123456789012:elastic-ip/*",
        "arn:aws:ec2:us-east-1::image/*",
        "arn:aws:ec2:us-east-1:123456789012:security-group/*"
      ]
    },
    {
      "Sid": "DeleteApprovedLoadBalancers",
      "Effect": "Allow",
      "Action": "elasticloadbalancing:DeleteLoadBalancer",
      "Resource": [
        "arn:aws:elasticloadbalancing:us-east-1:123456789012:loadbalancer/app/*",
        "arn:aws:elasticloadbalancing:us-east-1:123456789012:loadbalancer/net/*",
        "arn:aws:elasticloadbalancing:us-east-1:123456789012:loadbalancer/gwy/*"
      ]
    },
    {
      "Sid": "NeverDeleteProtectedResources",
      "Effect": "Deny",
      "Action": [
        "ec2:ReleaseAddress",
        "ec2:DeregisterImage",
        "ec2:DeleteSecurityGroup",
        "elasticloadbalancing:DeleteLoadBalancer"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/cleanup-protect": "true"
        }
      }
    },
    {
      "Sid": "ConsumeApprovalQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:us-east-1:123456789012:unused-resource-approvals"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:123456789012:log-group:/aws/lambda/unused-resource-cleanup:*"
    }
  ]
}
